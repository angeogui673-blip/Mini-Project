<?xml version="1.0" encoding="UTF-8"?>

<!-- Vue : la description de la fenêtre, sans aucune logique. -->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="contacts.ContactsController" spacing="8">
    <padding>
        <Insets top="12" right="12" bottom="12" left="12"/>
    </padding>

    <Label text="Nom"/>
    <TextField fx:id="champNom" onAction="#ajouter"/>
    <Label text="Téléphone"/>
    <TextField fx:id="champTelephone" onAction="#ajouter"/>
    <Button text="Ajouter" onAction="#ajouter"/>
    <Label fx:id="message" textFill="#b00020" wrapText="true"/>
    <ListView fx:id="listeContacts" VBox.vgrow="ALWAYS"/>
</VBox>
